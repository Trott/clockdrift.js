{
  "name": "clockdrift",
  "description": "Use HTTP headers to see if servers have synchronized clocks or not",
  "version": "5.0.0",
  "homepage": "https://github.com/Trott/clockdrift.js",
  "author": {
    "name": "Rich Trott",
    "email": "rtrott@gmail.com"
  },
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "clockdrift.js",
    "package.json"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "npm run lint && tsc && node test.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Trott/clockdrift.js.git"
  },
  "bugs": {
    "url": "https://github.com/Trott/clockdrift.js/issues"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/Trott/clockdrift.js/blob/master/LICENSE"
    }
  ],
  "main": "clockdrift.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [],
  "preferGlobal": true,
  "bin": {
    "clockdrift": "clockdrift.js"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.12.0",
    "neostandard": "^0.14.0",
    "semantic-release": "^25.0.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.2"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
